# AgriDoc Backend Environment Variables

# Server Config
PORT=8000
HOST=0.0.0.0
ENV=development

# Cloudinary Configuration (Image & Audio Uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Supabase Configuration (Database & Auth)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_ANON_KEY=your_supabase_anon_key

# Google Cloud Text-to-Speech (Optional, gTTS fallback enabled automatically)
GOOGLE_APPLICATION_CREDENTIALS=path/to/google_service_account.json

# Firebase FCM (Push Notifications)
FIREBASE_SERVICE_ACCOUNT_KEY=path/to/firebase_credentials.json

# Hugging Face API Token (For keremberke/yolov8m-agriculture inference)
HF_TOKEN=your_huggingface_token_here
